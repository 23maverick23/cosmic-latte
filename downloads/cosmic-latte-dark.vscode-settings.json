  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "foreground": "#9E99B8"
        }
      },
      {
        "scope": "keyword",
        "settings": {
          "foreground": "#A899F7"
        }
      },
      {
        "scope": "storage",
        "settings": {
          "foreground": "#A899F7"
        }
      },
      {
        "scope": "string",
        "settings": {
          "foreground": "#56CB96"
        }
      },
      {
        "scope": "constant.numeric",
        "settings": {
          "foreground": "#F87986"
        }
      },
      {
        "scope": "entity.name.function",
        "settings": {
          "foreground": "#5DB1FA"
        }
      },
      {
        "scope": "support.function",
        "settings": {
          "foreground": "#5DB1FA"
        }
      },
      {
        "scope": "entity.name.type",
        "settings": {
          "foreground": "#EFC053"
        }
      },
      {
        "scope": "support.type",
        "settings": {
          "foreground": "#EFC053"
        }
      },
      {
        "scope": "entity.name.annotation",
        "settings": {
          "foreground": "#F7A0DB"
        }
      }
    ]
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "class": "#EFC053",
      "type": "#EFC053",
      "function": "#5DB1FA",
      "method": "#5DB1FA",
      "number": "#F87986",
      "string": "#56CB96",
      "comment": "#9E99B8"
    }
  }
}
